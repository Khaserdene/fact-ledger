# Хуулж .env нэртэй хадгалаад утгуудаа бөглөнө үү.

# AI provider: manual | gemini | claude
# manual = промпт хуулж AI-д paste хийх (үнэгүй, одоогийн ажиллагаа)
AI_PROVIDER=manual

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Fuzzy тулгалтын босгууд (0-100)
FUZZY_DEDUP_THRESHOLD=87
FUZZY_LINK_THRESHOLD=85
FUZZY_MERGE_THRESHOLD=92
