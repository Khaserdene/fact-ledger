# Өгөгдлийн сан: Хоосон орхивол profiling_facts.db (SQLite) ашиглана.
# Supabase Postgres ашиглах бол Supabase Dashboard -> Settings -> Database -> Connection string (URI)-ийг оруулна:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# AI provider: manual | gemini | claude
# manual = промпт хуулж AI-д paste хийх (үнэгүй, одоогийн ажиллагаа)
AI_PROVIDER=manual

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Fuzzy тулгалтын босгууд (0-100)
FUZZY_DEDUP_THRESHOLD=87
FUZZY_LINK_THRESHOLD=85
FUZZY_MERGE_THRESHOLD=92
